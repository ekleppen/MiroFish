# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# 可选：通过 Amazon Bedrock Converse 调用 Claude（如 Claude Haiku 5.5）
# 设置 LLM_PROVIDER=bedrock 后，LLM_API_KEY 填 Bedrock API key，LLM_BASE_URL 将被忽略
# 建议使用长期 key（ABSK 开头）；短期 key 最长 12 小时过期。修改 .env 后需重启后端
# LLM_PROVIDER=bedrock
# LLM_MODEL_NAME=us.anthropic.claude-haiku-5-5
# AWS_REGION=us-east-1
# 未指定输出上限的请求默认使用 32000 tokens（超过模型上限时会自动降低）
# BEDROCK_MAX_OUTPUT_TOKENS=32000
# 新版 Claude 模型默认自适应思考，思考 tokens 计入输出上限。未显式设置 effort 的调用使用此值
# （low / medium / high）；留空则使用模型默认值。人设丰富、私信实验和回复编码始终使用 low。
# BEDROCK_EFFORT=

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here
# 可选：模拟期间是否将 Agent 动作写入 Zep 图谱（默认 true）
# 设为 false 可跳过最慢的 Zep 步骤；报告将直接读取本地动作日志
# ZEP_SIMULATION_MEMORY=false

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
# 可选：加速 LLM 的提供方（openai 或 bedrock），默认与 LLM_PROVIDER 相同
# LLM_BOOST_PROVIDER=bedrock
